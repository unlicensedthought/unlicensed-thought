{
  "name": "unlicensed-thought",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "tokens": "node scripts/tokens.mjs",
    "dev": "npm run tokens && vite dev",
    "build": "npm run tokens && vite build && node scripts/check-build.mjs",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "verify": "npm run check && npm test && npm run build"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "3.0.11",
    "@sveltejs/kit": "2.70.4",
    "@sveltejs/vite-plugin-svelte": "5.1.1",
    "@types/node": "22.20.5",
    "svelte": "5.58.0",
    "svelte-check": "4.7.8",
    "typescript": "5.9.3",
    "vite": "6.4.6",
    "vitest": "3.2.7",
    "wrangler": "4.164.0"
  },
  "dependencies": {
    "marked": "15.0.12",
    "yaml": "2.9.1"
  }
}
